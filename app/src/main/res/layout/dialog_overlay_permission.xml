<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_card_dark"
        android:padding="28dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_crash_icon_circle"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="26dp"
                android:layout_height="20dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="12dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_overlay_icon_back" />

            <View
                android:layout_width="26dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_overlay_icon_front" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvPermissionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enable Overlay Access"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zen Client needs permission to draw over Minecraft so the bubble and ClickGUI can appear in-game. You'll be taken to a system settings screen — just enable the toggle for Zen Client and come back."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="22dp" />

        <Button
            android:id="@+id/btnGrantPermission"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Grant Permission"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:background="@drawable/bg_button_primary"
            android:stateListAnimator="@null"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnNotNow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Not Now"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:background="@drawable/bg_button_secondary"
            android:stateListAnimator="@null" />

    </LinearLayout>

</FrameLayout>
